# Пример переменных окружения VetAI. Скопируйте в .env и подставьте реальные значения.
# .env в .gitignore — секреты не коммитятся.

# S3 (Timeweb Cloud Storage). Ключи — только здесь, в коде их нет.
AK=your-s3-access-key
SK=your-s3-secret-key
S3_ENDPOINT=https://s3.twcstorage.ru
S3_BUCKET=lz810806-ai-data
S3_REGION=ru-1

# Backend
# DB_PATH=./data/index.db          # по умолчанию <repo>/data/index.db (read-only)
# HISTORY_DB_PATH=./data/history.db # writable-БД истории чатов (по умолч. <repo>/data/history.db)
# PDF_URL_TTL=300                   # TTL presigned-ссылки на PDF, секунды
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM чат-ассистент «найти источник» (OpenAI-совместимый, напр. router.ai).
# Секреты — только здесь; без ключа/URL/модели /api/chat отдаёт 503.
LLM_BASE_URL=                        # напр. https://router.ai/v1 (без /chat/completions)
LLM_API_KEY=                         # ключ провайдера — НЕ коммитить
LLM_MODEL=                           # напр. openai/gpt-4o-mini
# LLM_TIMEOUT=30                     # таймаут запроса, секунды
# LLM_MAX_TOKENS=700                 # лимит токенов на ответ
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOOL_CALLS=3               # макс. итераций function-calling цикла
# LLM_TOOL_MODE=inline               # inline (осн.: keywords→FTS→ответ) | tools
# LLM_DAILY_BUDGET_RUB=100          # суточный бюджет-гард
# LLM_RUB_PER_1K_TOKENS=0.2         # оценка стоимости 1К токенов (руб.)

# Ingest
# GALEN_LIMIT=0                     # 0 = все препараты Galen; >0 — ограничить (быстрый прогон)
